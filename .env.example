# Kopiere diese Datei nach .env und trag deine Werte ein. .env landet nie im Repo.
# Nur nötig für --source jellyfin.
JELLYFIN_URL=https://jellyfin.example.com
JELLYFIN_API_KEY=dein-api-key
# Optional, nur falls Jellyfin ohne Benutzer-ID nichts zurückgibt (Dashboard > Benutzer > ID aus der URL).
JELLYFIN_USER_ID=
